---
import Layout from "../layouts/Layout.astro";
import PaperCard from "../components/PaperCard.astro";
import papers from "../data/papers.json";
import meta from "../data/meta.json";

type Paper = (typeof papers)[number] & Record<string, any>;

const JOURNALS = [
  { key: "AER", short: "AER", color: "#1d5fa8" },
  { key: "JPE", short: "JPE", color: "#7c3aed" },
  { key: "QJE", short: "QJE", color: "#b45309" },
  { key: "RES", short: "REStud", color: "#0f766e" },
  { key: "ECTA", short: "ECTA", color: "#be185d" },
];
const jmap = Object.fromEntries(JOURNALS.map((j) => [j.key, j]));
const list = papers as Paper[];

const updated = new Date(meta.updated_at.replace(" UTC", "Z").replace(" ", "T"));
const daysAgo = (n: number) => new Date(updated.getTime() - n * 864e5).toISOString().slice(0, 10);
const weekAgo = daysAgo(7), recent = daysAgo(45);
const tracked = list.map((p) => p.first_seen).sort()[0] ?? "";   // date of the first run
const ym = (d: string) => { const [y, m] = (d || "").split("-"); return y ? `${y} 年 ${Number(m)} 月` : "日期不详"; };

// view 1: newest first, grouped by month of first online appearance
const months: { label: string; items: Paper[] }[] = [];
for (const p of list) {
  const label = ym(p.online);
  if (months.at(-1)?.label !== label) months.push({ label, items: [] });
  months.at(-1)!.items.push(p);
}

// view 2: a table of contents per journal: ahead-of-print queue first, then issues newest first
const num = (s: string) => Number(String(s).match(/\d+/)?.[0] ?? 0);
const tocs = JOURNALS.map((j) => {
  const mine = list.filter((p) => p.journal === j.key);
  const aop = mine.filter((p) => !p.issue);
  const byIssue = new Map<string, Paper[]>();
  for (const p of mine.filter((p) => p.issue)) {
    const k = `${p.volume}|${p.issue}`;
    byIssue.set(k, [...(byIssue.get(k) ?? []), p]);
  }
  const issues = [...byIssue.entries()].map(([k, items]) => {
    const [volume, issue] = k.split("|");
    const printed = items.map((p) => p.print).filter(Boolean).sort().at(-1) ?? "";
    // within an issue, follow the page order
    items.sort((a, b) => num(a.pages) - num(b.pages));
    return { volume, issue, printed, items };
  }).sort((a, b) => num(b.volume) - num(a.volume) || num(b.issue) - num(a.issue));
  return { j, aop, issues, count: mine.length };
});

const [sy, sm] = ((meta as any).since ?? "").split("-");
const since = sy ? `${sy} 年 ${Number(sm)} 月以来` : "";
const fmtUpdated = new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Shanghai" }).format(updated);
---
<Layout>
  <main>
    <section class="page-heading">
      <p class="eyebrow">Top 5 Economics Journals</p>
      <h1>五大期刊 · 最新论文</h1>
      <p>AER / JPE / QJE / REStud / Econometrica · {list.length} 篇（首次在线或刊出于 {since}）· 更新于 {fmtUpdated}</p>
    </section>

    <section class="workspace" aria-label="论文列表">
      <div class="toolbar">
        <div class="views" role="tablist" aria-label="展示方式">
          <button type="button" class="view active" data-view="latest">最新在线</button>
          <button type="button" class="view" data-view="issues">按期目录</button>
        </div>
        <div class="tabs" role="tablist" aria-label="选择期刊">
          <button type="button" class="tab active" data-j="all">全部 <em>{list.length}</em></button>
          {JOURNALS.map((j) => (
            <button type="button" class="tab" data-j={j.key} style={`--jc:${j.color}`}>{j.short} <em>{(meta.journals as any)[j.key]?.count ?? 0}</em></button>
          ))}
        </div>
        <label class="search">
          <span class="sr-only">检索</span>
          <input id="q" type="search" autocomplete="off" placeholder="检索标题、作者、摘要（中英文）" />
        </label>
      </div>

      <div data-pane="latest">
        {months.map((m) => (
          <section class="group" data-group>
            <h2 class="group-label">{m.label}</h2>
            <ol class="papers">
              {m.items.map((p) => <PaperCard p={p} j={jmap[p.journal]} weekAgo={weekAgo} recent={recent} tracked={tracked} />)}
            </ol>
          </section>
        ))}
      </div>

      <div data-pane="issues" hidden>
        {tocs.map((t) => (
          <section class="journal" data-journal={t.j.key} style={`--jc:${t.j.color}`}>
            <h2 class="journal-label">{t.j.short} <span>{t.count} 篇</span></h2>
            {t.aop.length > 0 && (
              <section class="group" data-group>
                <h3 class="group-label">提前在线（尚未分期）<span>{t.aop.length} 篇</span></h3>
                <ol class="papers">{t.aop.map((p) => <PaperCard p={p} j={t.j} weekAgo={weekAgo} recent={recent} tracked={tracked} />)}</ol>
              </section>
            )}
            {t.issues.map((iss) => (
              <section class="group" data-group>
                <h3 class="group-label">Vol. {iss.volume} No. {iss.issue}{iss.printed && ` · ${ym(iss.printed)}`}<span>{iss.items.length} 篇</span></h3>
                <ol class="papers">{iss.items.map((p) => <PaperCard p={p} j={t.j} weekAgo={weekAgo} recent={recent} tracked={tracked} />)}</ol>
              </section>
            ))}
          </section>
        ))}
      </div>
      <p class="empty" hidden>没有符合条件的论文。</p>
    </section>
  </main>

  <script is:inline>
    const tabs = [...document.querySelectorAll(".tab")];
    const views = [...document.querySelectorAll(".view")];
    const panes = [...document.querySelectorAll("[data-pane]")];
    const q = document.getElementById("q");
    const empty = document.querySelector(".empty");
    const store = { get(k) { try { return localStorage.getItem(k); } catch { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch {} } };
    let journal = "all", view = store.get("top5-view") === "issues" ? "issues" : "latest";

    function apply() {
      const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const pane = panes.find((p) => p.dataset.pane === view);
      panes.forEach((p) => (p.hidden = p !== pane));
      views.forEach((b) => b.classList.toggle("active", b.dataset.view === view));
      let shown = 0;
      for (const c of pane.querySelectorAll(".paper")) {
        const ok = (journal === "all" || c.dataset.j === journal) && terms.every((t) => c.dataset.s.includes(t));
        c.hidden = !ok;
        shown += ok;
      }
      for (const g of pane.querySelectorAll("[data-group]")) g.hidden = !g.querySelector(".paper:not([hidden])");
      for (const s of pane.querySelectorAll("[data-journal]")) s.hidden = !s.querySelector(".paper:not([hidden])");
      empty.hidden = shown > 0;
    }
    function pick(key, push = true) {
      journal = key;
      tabs.forEach((t) => t.classList.toggle("active", t.dataset.j === key));
      if (push) history.replaceState(null, "", key === "all" ? location.pathname : `#${key.toLowerCase()}`);
      apply();
    }
    tabs.forEach((t) => t.addEventListener("click", () => pick(t.dataset.j)));
    views.forEach((b) => b.addEventListener("click", () => { view = b.dataset.view; store.set("top5-view", view); apply(); }));
    q.addEventListener("input", apply);
    document.querySelectorAll(".abs-en.solo").forEach((p) => p.addEventListener("click", () => p.classList.toggle("open")));
    const h = location.hash.slice(1).toUpperCase();
    if (tabs.some((t) => t.dataset.j === h)) pick(h, false); else apply();
  </script>
</Layout>
