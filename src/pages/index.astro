---
import Layout from "../layouts/Layout.astro";
import papers from "../data/papers.json";
import meta from "../data/meta.json";

type Paper = (typeof papers)[number] & Record<string, any>;

const JOURNALS = [
  { key: "AER", short: "AER", color: "#1d5fa8" },
  { key: "JPE", short: "JPE", color: "#7c3aed" },
  { key: "QJE", short: "QJE", color: "#b45309" },
  { key: "RES", short: "REStud", color: "#0f766e" },
  { key: "ECTA", short: "ECTA", color: "#be185d" },
];
const jmap = Object.fromEntries(JOURNALS.map((j) => [j.key, j]));
const list = papers as Paper[];

// "new" = first picked up within a week of the latest update
const updated = new Date(meta.updated_at.replace(" UTC", "Z").replace(" ", "T"));
const weekAgo = new Date(updated.getTime() - 7 * 864e5).toISOString().slice(0, 10);

const months: { label: string; items: Paper[] }[] = [];
for (const p of list) {
  const [y, m] = (p.online || "").split("-");
  const label = y ? `${y} 年 ${Number(m)} 月` : "日期不详";
  if (months.at(-1)?.label !== label) months.push({ label, items: [] });
  months.at(-1)!.items.push(p);
}

const issueOf = (p: Paper) =>
  p.issue ? `Vol. ${p.volume} No. ${p.issue}${p.pages ? ` · pp. ${p.pages}` : ""}` : "提前在线";
const sourceNote = (p: Paper) =>
  p.abstract_source === "working-paper" ? `摘要暂取自工作论文版本${p.wp_source ? `（${p.wp_source}）` : ""}，期刊版发布后自动替换`
  : !p.abstract ? "期刊尚未公开摘要，下次更新时再补"
  : "";
const fmtUpdated = new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Shanghai" }).format(updated);
const [oy, om] = ((meta as any).since ?? list.at(-1)?.online ?? "").split("-");
const since = oy ? `${oy} 年 ${Number(om)} 月以来` : "";
---
<Layout>
  <main>
    <section class="page-heading">
      <p class="eyebrow">Top 5 Economics Journals</p>
      <h1>五大期刊 · 最新论文</h1>
      <p>AER / JPE / QJE / REStud / Econometrica · {list.length} 篇（{since}）· 更新于 {fmtUpdated}</p>
    </section>

    <section class="workspace" aria-label="论文列表">
      <div class="toolbar">
        <div class="tabs" role="tablist" aria-label="选择期刊">
          <button type="button" class="tab active" data-j="all">全部 <em>{list.length}</em></button>
          {JOURNALS.map((j) => (
            <button type="button" class="tab" data-j={j.key} style={`--jc:${j.color}`}>{j.short} <em>{(meta.journals as any)[j.key]?.count ?? 0}</em></button>
          ))}
        </div>
        <label class="search">
          <span class="sr-only">检索</span>
          <input id="q" type="search" autocomplete="off" placeholder="检索标题、作者、摘要（中英文）" />
        </label>
      </div>

      {months.map((m) => (
        <section class="month" data-month>
          <h2 class="month-label">{m.label}</h2>
          <ol class="papers">
            {m.items.map((p) => {
              const j = jmap[p.journal];
              return (
                <li class="paper" data-j={p.journal} style={`--jc:${j.color}`}
                    data-s={[p.title, p.title_cn, p.authors.join(" "), p.abstract, p.abstract_cn].join(" ").toLowerCase()}>
                  <div class="meta-line">
                    <span class="jbadge">{j.short}</span>
                    <span class:list={["issue", { aop: !p.issue }]}>{issueOf(p)}</span>
                    <span class="date">{p.online}</span>
                    {p.first_seen >= weekAgo && <span class="new">新</span>}
                  </div>
                  {p.title_cn && <h3 class="title-cn">{p.title_cn}</h3>}
                  <a class="title-en" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">{p.title}</a>
                  <p class="authors">{p.authors.join(", ")}</p>
                  {p.abstract_cn ? (
                    <div class="abstract">
                      <p class="abs-cn">{p.abstract_cn}</p>
                      <details>
                        <summary>英文摘要</summary>
                        <p class="abs-en">{p.abstract}</p>
                      </details>
                    </div>
                  ) : p.abstract ? (
                    <div class="abstract"><p class="abs-en solo">{p.abstract}</p></div>
                  ) : null}
                  {sourceNote(p) && <p class="src-note">{sourceNote(p)}</p>}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
      <p class="empty" hidden>没有符合条件的论文。</p>
    </section>
  </main>

  <script is:inline>
    const tabs = [...document.querySelectorAll(".tab")];
    const cards = [...document.querySelectorAll(".paper")];
    const months = [...document.querySelectorAll("[data-month]")];
    const q = document.getElementById("q");
    const empty = document.querySelector(".empty");
    let journal = "all";

    function apply() {
      const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const ok = (journal === "all" || c.dataset.j === journal) && terms.every((t) => c.dataset.s.includes(t));
        c.hidden = !ok;
        shown += ok;
      }
      for (const m of months) m.hidden = !m.querySelector(".paper:not([hidden])");
      empty.hidden = shown > 0;
    }
    function pick(key, push = true) {
      journal = key;
      tabs.forEach((t) => t.classList.toggle("active", t.dataset.j === key));
      if (push) history.replaceState(null, "", key === "all" ? location.pathname : `#${key.toLowerCase()}`);
      apply();
    }
    tabs.forEach((t) => t.addEventListener("click", () => pick(t.dataset.j)));
    q.addEventListener("input", apply);
    document.querySelectorAll(".abs-en.solo").forEach((p) => p.addEventListener("click", () => p.classList.toggle("open")));
    const h = location.hash.slice(1).toUpperCase();
    if (tabs.some((t) => t.dataset.j === h)) pick(h, false);
  </script>
</Layout>
